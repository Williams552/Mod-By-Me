<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Core Building: Archotech Resonator -->
  <ThingDef ParentName="BuildingBase">
    <defName>ER_ArchotechResonator</defName>
    <label>archotech resonator</label>
    <description>The primary anchor structure for the colony's Echo Pool. Taps into subtle psychic vibrations generated by the colony's achievements and converts them into spendable Echo points.\n\nOnly one Resonator can exist per map. Requires power to function. If destroyed, all unspent Echo points are permanently lost!</description>
    <thingClass>EchoResonance.Buildings.Building_Resonator</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/Misc/ArchotechResonator</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <shadowData>
        <volume>(2.6, 1.0, 2.6)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>1.0</fillPercent>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <WorkToBuild>4000</WorkToBuild>
      <Flammability>0.2</Flammability>
    </statBases>
    <size>(3,3)</size>
    <costList>
      <Steel>150</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>200</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
    <placeWorkers>
      <li>EchoResonance.Buildings.PlaceWorker_SingleResonator</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>ResonanceCore</li>
    </researchPrerequisites>
    <designationCategory>Misc</designationCategory>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
  </ThingDef>

  <!-- Booster Building: Attunement Pylon -->
  <ThingDef ParentName="BuildingBase">
    <defName>ER_AttunementPylon</defName>
    <label>attunement pylon</label>
    <description>A specialized resonance amplifier. Each powered pylon within 12 cells of the Archotech Resonator increases total Echo accumulation speed by +50% (up to a maximum of x3.0 with 4 pylons).\n\nMust be built within 12 cells of the Resonator and at least 8 cells away from other Pylons.</description>
    <thingClass>EchoResonance.Buildings.Building_AttunementPylon</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/Misc/AttunementPylon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>1500</WorkToBuild>
      <Flammability>0.1</Flammability>
    </statBases>
    <size>(1,1)</size>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
      <Gold>20</Gold>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>100</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
    <placeWorkers>
      <li>EchoResonance.Buildings.PlaceWorker_PylonPlacement</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>ResonanceCore</li>
    </researchPrerequisites>
    <designationCategory>Misc</designationCategory>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
  </ThingDef>

</Defs>
