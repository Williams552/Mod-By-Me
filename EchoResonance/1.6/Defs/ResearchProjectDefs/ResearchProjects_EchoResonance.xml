<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Tier 1 Research: Resonance Core -->
  <ResearchProjectDef>
    <defName>ResonanceCore</defName>
    <label>resonance core</label>
    <description>Unlock the secrets of Archotech resonance. Allows building the Archotech Resonator and Attunement Pylons, opening the Echo Pool for Tier 1 Pawn Perks.</description>
    <baseCost>1500</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>MicroelectronicsBasics</li>
    </prerequisites>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
    <researchViewX>10.0</researchViewX>
    <researchViewY>3.5</researchViewY>
  </ResearchProjectDef>

  <!-- Tier 2 Research: Echo Attunement -->
  <ResearchProjectDef>
    <defName>EchoAttunement</defName>
    <label>echo attunement</label>
    <description>Harmonize colonial thoughts to unlock Tier 2 Pawn Perks and craft Resonance Focus crystals at the Fabrication Bench.</description>
    <baseCost>3000</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>ResonanceCore</li>
      <li>Fabrication</li>
    </prerequisites>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
    <researchViewX>11.5</researchViewX>
    <researchViewY>3.5</researchViewY>
  </ResearchProjectDef>

  <!-- Tier 3 Research: Archotech Resonance -->
  <ResearchProjectDef>
    <defName>ArchotechResonance</defName>
    <label>archotech resonance</label>
    <description>Achieve complete mastery over Archotech resonance. Unlocks Tier 3 Pawn Perks without catalyst item requirements.</description>
    <baseCost>6000</baseCost>
    <techLevel>Spacer</techLevel>
    <prerequisites>
      <li>EchoAttunement</li>
      <li>ShipBasics</li>
    </prerequisites>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
    <researchViewX>13.0</researchViewX>
    <researchViewY>3.5</researchViewY>
  </ResearchProjectDef>

</Defs>
