  <HediffDef ParentName="ER_PerkHediffBase">
    <defName>ER_Hediff_IronStomach</defName>
    <label>iron stomach</label>
    <description>Immune to food poisoning and raw food mood debuffs.</description>
    <stages>
      <li>
        <statFactors>
          <FoodPoisonChance>0</FoodPoisonChance>
        </statFactors>
